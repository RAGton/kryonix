[General]
Name=Kryonix Blue Glass Light
ColorScheme=KryonixBlueGlassLight
accentActiveTitlebar=false
shadeSortColumn=true

# Variante clara do Kryonix Blue Glass.
# Backgrounds/texts invertidos em relação à paleta dark.
# Accent colors são os mesmos da paleta oficial Kryonix
# (desktop/branding/kryonix/palette.nix) para consistência visual:
#   accentBlue: 56,189,248  (#38bdf8)
#   accentCyan: 0,212,255   (#00d4ff)
# Texto escuro usa a cor de background da paleta dark (#0b0f14 = 11,15,20)

